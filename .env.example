VOICE_REGIONS=rotterdam,frankfurt,milan,madrid
# Müzik (isteğe bağlı, varsayılanlar genelde yeterli)
# Çalan şarkının Opus paketlerinin bellekte tutulacağı üst sınır (MB). Sarma ve tekrar bu bellekten yapılır.
# SARMA_ONBELLEK_MB=20
# YouTube araması bu sürede (ms) cevap vermezse komut hata verir.
# ARAMA_ZAMAN_ASIMI_MS=15000
# Ana thread bu kadar ms duraksarsa log'a uyarı yazılır / kontrol aralığı (ms).
# GECIKME_ESIGI_MS=100
# GECIKME_ARALIGI_MS=10000
# Ses bağlantısı: el sıkışma bu kadar ms içinde kurulmazsa bölge değiştirilip yeniden denenir (varsayılan 15000).
# VOICE_BAGLANTI_BEKLEME_MS=15000
# Sıra bitince bot bu kadar ms kanalda bekler, sonra çıkar (varsayılan 120000). Kanalda kimse kalmazsa 30 sn sonra çıkar.
# SIRA_BITTI_BEKLEME_MS=120000
# Şarkı akışından ilk veri bu kadar ms içinde gelmezse deneme başarısız sayılır; bir kez daha denenir (varsayılan 45000).
# ILK_VERI_BEKLEME_MS=45000
